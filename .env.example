# =============================================================================
# Candle environment configuration
# =============================================================================
# Copy this file to `.env` (never commit `.env`) and fill in real values.
# Development defaults are provided inline; production MUST set the required
# variables marked [REQUIRED].

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Development:      config.settings.development
# Test (pytest):    config.settings.test   (set automatically by pyproject.toml)
# Production:       config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# [REQUIRED in production] Long random value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# true / false. Production is always False (hardcoded in production.py).
DJANGO_DEBUG=true

# -----------------------------------------------------------------------------
# Database
# Set DJANGO_DATABASE_ENGINE=sqlite for PythonAnywhere's SQLite deployment.
# PostgreSQL remains the default for non-PythonAnywhere production.
# -----------------------------------------------------------------------------
DJANGO_DATABASE_ENGINE=postgresql
SQLITE_NAME=db.sqlite3
POSTGRES_DB=candle
POSTGRES_USER=candle
POSTGRES_PASSWORD=candle
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (>= 6.0 for the RESP2 HELLO handshake used by channels-redis 4.3).
# Required for the realtime channel layer + rate-limit cache in production.
# Redis holds ONLY ephemeral data (presence, rate limiting, WS fan-out).
# Authoritative whiteboard history always lives in PostgreSQL.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# PythonAnywhere without Redis: use process-local backends. This is suitable
# for its single WSGI worker; WebSocket collaboration requires an ASGI host
# with a shared channel layer.
DJANGO_CACHE_BACKEND=redis
DJANGO_CHANNEL_LAYER_BACKEND=redis

# -----------------------------------------------------------------------------
# Hosts & origins
# -----------------------------------------------------------------------------
# [REQUIRED in production] Comma-separated hostnames, e.g. candle.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# [REQUIRED in production] Trusted WebSocket origins, e.g. https://candle.example.com
WEBSOCKET_ALLOWED_ORIGINS=

# [REQUIRED in production] CSRF trusted origins, e.g. https://candle.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Public origin used for absolute links in emails (no trailing slash).
DJANGO_SITE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Development defaults to console. In production set the SMTP backend + creds.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10

# -----------------------------------------------------------------------------
# Session / security (production.py applies sensible fixed values; SBJT tune)
# -----------------------------------------------------------------------------
# Session lifetime in seconds (production default: 86400 = 24h).
# SESSION_COOKIE_AGE=86400
# Expire session cookie when the browser closes (production default: true).
# SESSION_EXPIRE_AT_BROWSER_CLOSE=true
# Referrer policy sent to browsers (production default below).
# SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# -----------------------------------------------------------------------------
# Request limits (optional overrides; production.py sets 5 MB / 1000 fields)
# -----------------------------------------------------------------------------
# DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# -----------------------------------------------------------------------------
# Partnership / product tuning (optional)
# -----------------------------------------------------------------------------
# Invitation validity window (hours).
# PARTNERSHIP_INVITATION_EXPIRY_HOURS=168

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# Structured JSON logging toggle (set to true in production).
# LOG_JSON=true
