# =============================================================================
# Candle environment configuration
# =============================================================================
# Copy this file to `.env` (never commit `.env`) and fill in real values.
# This template targets the PythonAnywhere production deployment. Never commit
# the real `.env` or a Gmail app password.

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Production settings for PythonAnywhere.
DJANGO_SETTINGS_MODULE=config.settings.production

# [REQUIRED in production] Long random value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters

# true / false. Production is always False (hardcoded in production.py).
DJANGO_DEBUG=false

# -----------------------------------------------------------------------------
# Database
# Set DJANGO_DATABASE_ENGINE=sqlite for PythonAnywhere's SQLite deployment.
# PostgreSQL remains the default for non-PythonAnywhere production.
# -----------------------------------------------------------------------------
DJANGO_DATABASE_ENGINE=sqlite
SQLITE_NAME=/home/cand/candle/data/db.sqlite3
POSTGRES_DB=candle
POSTGRES_USER=candle
POSTGRES_PASSWORD=candle
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Production only — TLS mode for the Postgres connection. Most managed
# Postgres providers require this; self-hosted instances on a private network
# may set it to "disable".
# POSTGRES_SSLMODE=require
# Seconds before giving up on an unreachable Postgres host (not just a
# rejected connection — a genuinely unreachable one, e.g. wrong host/network
# outage). Without this, the OS's own TCP timeout applies, which can be far
# longer than acceptable for a readiness probe like /health/ready/.
# POSTGRES_CONNECT_TIMEOUT=5

# -----------------------------------------------------------------------------
# Redis (>= 6.0 for the RESP2 HELLO handshake used by channels-redis 4.3).
# Required for the realtime channel layer + rate-limit cache in production.
# Redis holds ONLY ephemeral data (presence, rate limiting, WS fan-out).
# Authoritative whiteboard history lives in the configured database.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# PythonAnywhere without Redis: use process-local backends. This is suitable
# for its single WSGI worker; WebSocket collaboration requires an ASGI host
# with a shared channel layer.
DJANGO_CACHE_BACKEND=locmem
DJANGO_CHANNEL_LAYER_BACKEND=inmemory

# -----------------------------------------------------------------------------
# Hosts & origins
# -----------------------------------------------------------------------------
# [REQUIRED in production] Comma-separated hostnames, e.g. candle.example.com
DJANGO_ALLOWED_HOSTS=cand.pythonanywhere.com

# [REQUIRED in production] Trusted WebSocket origins, e.g. https://candle.example.com
WEBSOCKET_ALLOWED_ORIGINS=https://cand.pythonanywhere.com

# [REQUIRED in production] CSRF trusted origins, e.g. https://candle.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://cand.pythonanywhere.com

# Public origin used for absolute links in emails (no trailing slash).
DJANGO_SITE_URL=https://cand.pythonanywhere.com

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Gmail SMTP. The password must be a Google app password, not your normal
# Gmail password. Create one at https://myaccount.google.com/apppasswords
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=gulzar.ufone@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=replace-with-a-16-character-gmail-app-password
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_TIMEOUT=10

# -----------------------------------------------------------------------------
# Session / security (production.py applies sensible fixed values; SBJT tune)
# -----------------------------------------------------------------------------
# Session lifetime in seconds (production default: 86400 = 24h).
# SESSION_COOKIE_AGE=86400
# Expire session cookie when the browser closes (production default: true).
# SESSION_EXPIRE_AT_BROWSER_CLOSE=true
# Referrer policy sent to browsers (production default below).
# SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# -----------------------------------------------------------------------------
# Request limits (optional overrides; production.py sets 5 MB / 1000 fields)
# -----------------------------------------------------------------------------
# DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
# Overall HTTP request body cap (any endpoint), enforced by
# apps.core.middleware.RequestSizeGuard before the body is even read.
# MAX_REQUEST_BODY_BYTES=5242880

# -----------------------------------------------------------------------------
# Partnership / product tuning (optional)
# -----------------------------------------------------------------------------
# Invitation validity window (hours).
# PARTNERSHIP_INVITATION_EXPIRY_HOURS=168

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# Structured JSON logging toggle (set to true in production).
# LOG_JSON=true
